# Fastfile for iOS deployment (certificate-based manual signing in CI)

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight (Certificate-Based)"
  lane :beta do
    # Certificates and the App Store profile are installed by the GitHub Actions workflow.
    
    # Use build number from environment (GitHub run number) or increment local
    if ENV['BUILD_NUMBER']
      new_build = ENV['BUILD_NUMBER'].to_i
      UI.message("Using build number from environment: #{new_build}")
    else
      # Fallback to local build number increment
      new_build = get_build_number(xcodeproj: "Runner.xcodeproj").to_i + 1
      UI.message("Using incremented local build number: #{new_build}")
    end
    
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: new_build
    )
    
    # Use the distribution certificate and App Store profile installed by CI.
    profile_name = ENV['PROVISIONING_PROFILE_SPECIFIER'].to_s
    UI.user_error!("PROVISIONING_PROFILE_SPECIFIER is not set") if profile_name.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV['TEAM_ID'],
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: "com.cross.app"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/Runner",
      output_name: "Runner.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        uploadSymbols: true,
        uploadBitcode: false,
        teamID: ENV['TEAM_ID'],
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.cross.app" => profile_name
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )
    
    # Upload to TestFlight - Fastlane auto-uses environment variables
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
    
    # Clean up
    clean_build_artifacts
  end
  
  desc "Build the app for App Store submission (Certificate-Based)"
  lane :release do
    # Use build number from environment (GitHub run number) or increment local
    if ENV['BUILD_NUMBER']
      new_build = ENV['BUILD_NUMBER'].to_i
      UI.message("Using build number from environment: #{new_build}")
    else
      # Fallback to local build number increment
      new_build = get_build_number(xcodeproj: "Runner.xcodeproj").to_i + 1
      UI.message("Using incremented local build number: #{new_build}")
    end
    
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: new_build
    )
    
    # Use the distribution certificate and App Store profile installed by CI.
    profile_name = ENV['PROVISIONING_PROFILE_SPECIFIER'].to_s
    UI.user_error!("PROVISIONING_PROFILE_SPECIFIER is not set") if profile_name.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV['TEAM_ID'],
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: "com.cross.app"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/Runner",
      output_name: "Runner.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        uploadSymbols: true,
        uploadBitcode: false,
        teamID: ENV['TEAM_ID'],
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.cross.app" => profile_name
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )
    
    # Upload to App Store Connect - Fastlane auto-uses environment variables
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
    
    # Clean up
    clean_build_artifacts
  end
  
  desc "Setup for automatic signing with API key"
  lane :setup_auto_signing do
    # Configure project for automatic signing
    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV['TEAM_ID']
    )
    
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      team_id: ENV['TEAM_ID'],
      targets: ["Runner"],
      code_sign_identity: "Apple Development"
    )
    
    UI.success("Project configured for automatic signing")
  end
  
  desc "Check signing configuration"
  lane :check_signing do
    # Check current signing configuration
    UI.message("Checking signing configuration...")
    
    get_info_plist_value(
      path: "Runner/Info.plist",
      key: "CFBundleIdentifier"
    )
    
    get_provisioning_profile
  end
end